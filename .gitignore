# NOTE: git does not support trailing inline comments after a pattern, so every
# comment here is on its own line.

# ── Build & environment (never commit; ~1.3 GB on disk) ─────────────────────
# build/ = CMake/FetchContent clones (boost/sentencepiece/onpair), binaries,
# sqlite, smoke workdir, figures.  .venv/ = Python virtualenv (~273 MB).
build/
build_*/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ── Real datasets — materialised on the measurement rig (~6.8 GB) ───────────
# `make datasets` downloads to datasets/raw/ and extracts to
# datasets/materialized/.  Committed smoke fixtures live under testdata/datasets/
# (a DIFFERENT path) and are NOT matched by this rule, so they stay tracked.
/datasets/

# ── Result stores / exports / figures (regenerated by every run) ────────────
*.sqlite
*.sqlite-wal
*.sqlite-shm
results.csv
results_agg.csv
*.png
*.pdf
# golden-fixture plots for the reproducibility test ARE tracked
!tests/golden/*.png

# ── In-source build artifacts ───────────────────────────────────────────────
*.o
*.a
*.so
*.dylib
*.dSYM/

# ── Misc ────────────────────────────────────────────────────────────────────
*.tmp
.DS_Store
